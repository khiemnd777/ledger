rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function under(limit) {
      return request.resource.size < limit;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /users/{uid}/shops/{shopId}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
    }

    match /users/{uid}/shops/{shopId}/product-images/{productId}/{fileName} {
      allow create: if isOwner(uid) && under(8 * 1024 * 1024) && isImage();
      allow update: if false;
    }

    match /users/{uid}/shops/{shopId}/receipt-images/{saleId}/{fileName} {
      allow create: if isOwner(uid) && under(8 * 1024 * 1024) && isImage();
      allow update: if false;
    }

    match /users/{uid}/shops/{shopId}/changes/{year}/{month}/{fileName} {
      allow create: if isOwner(uid) && under(10 * 1024 * 1024)
        && request.resource.contentType == 'application/gzip'
        && fileName.matches('change-[A-Za-z0-9-]+\\.json\\.gz');
      allow update: if false;
    }

    match /users/{uid}/shops/{shopId}/snapshots/{year}/{month}/{fileName} {
      allow create: if isOwner(uid) && under(25 * 1024 * 1024)
        && request.resource.contentType == 'application/gzip'
        && fileName.matches('snapshot-[A-Za-z0-9-]+\\.json\\.gz');
      allow update: if false;
    }

    match /users/{uid}/shops/{shopId}/qr-labels/{variantId}/{fileName} {
      allow create: if isOwner(uid) && under(2 * 1024 * 1024)
        && request.resource.contentType == 'image/svg+xml';
      allow update: if false;
    }

    match /users/{uid}/shops/{shopId}/exports/{year}/{month}/{fileName} {
      allow create: if isOwner(uid) && under(20 * 1024 * 1024)
        && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
